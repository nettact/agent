# Sibling-repo source lock for release builds (see .github/workflows/release.yml).
# The release workflow checks out these repos at these exact commits, so a tag
# rebuilds identically and never depends on a sibling repo having its own tag.
# To pick up newer sibling code: update the SHA (PR) and cut a new tag.
PROTOCOL_SHA=2e09573336615da2c0790b1573116db0378e92ab
